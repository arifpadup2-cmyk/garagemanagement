# Copy to .env and fill in. .env is gitignored.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PORT=3000
# Admin login (validated server-side; keep out of source control)
ADMIN_USER=arifpadup
ADMIN_PASSWORD=change-me
ADMIN_NAME=ARIF
# Token-signing secret — MUST be a strong random value, SEPARATE from the
# password. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, sessions use a random per-boot secret (everyone is logged out on each restart).
SESSION_SECRET=change-me-to-a-64-char-random-hex-string
